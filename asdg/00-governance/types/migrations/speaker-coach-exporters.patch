+def recorded_path(value):
+    """Resolve preserved evidence only through the supported migration receipt."""
+    receipt = CONSUMER / "docs/asdg/00-governance/logs/namespace-migration.json"
+    mapping = {row["before_path"]: row["after_path"]
+               for row in json.loads(receipt.read_text())["files"]}
+    old = Path(value)
+    if old.is_absolute():
+        old = old.relative_to(CONSUMER)
+    key = old.as_posix()
+    if key not in mapping:
+        raise FileNotFoundError(f"Historical artifact is absent from the migration receipt: {key}")
+    relative = Path(mapping[key])
+    target = CONSUMER / relative
+    if (relative.is_absolute() or ".." in relative.parts or target.is_symlink()
+            or not target.resolve().is_relative_to(CONSUMER.resolve())):
+        raise ValueError("Invalid migrated evidence path")
+    return relative
+
