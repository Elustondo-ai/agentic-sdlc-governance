#!/usr/bin/env python3
"""Repository convenience entry point for the canonical embedded ASDG runtime."""
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'asdg/scripts/lib'))
from cli import main

if __name__ == '__main__':
    sys.exit(main())
